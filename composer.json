{
  "name": "roots/bedrock",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with Composer, easier configuration, and an improved folder structure",
  "homepage": "https://roots.io/bedrock/",
  "authors": [
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "bedrock", "composer", "roots", "wordpress-composer", "wordpress", "wp-composer", "wp-config", "wp"
  ],
  "support": {
    "issues": "https://github.com/roots/bedrock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "name": "creame",
      "type": "composer",
      "url": "https://packages.crea.me"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "6.9.*",
    "roots/wp-config": "1.0.0",
    "vendor/elementor-pro": "^4.1",
    "vendor/happyfiles-pro": "^1.8",
    "vendor/perfmatters": "^2.5",
    "vlucas/phpdotenv": "^5.6",
    "wp-plugin/analytics-insights": "^6.3",
    "wp-plugin/autodescription": "^5.1",
    "wp-plugin/cache-enabler": "^1.8",
    "wp-plugin/duplicate-post": "^4.5",
    "wp-plugin/elementor": "^4.1",
    "wp-plugin/images-to-webp": "^4.8",
    "wp-plugin/menu-caching": "^1.1",
    "wp-plugin/no-nonsense": "^3.6",
    "wp-plugin/redirection": "^5.5",
    "wp-theme/hello-elementor": "^3.4"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "mindtwo/wplang": "^2.1",
    "pestphp/pest": "^4.0",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-plugin/performant-translations": "^1.2"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "pestphp/pest-plugin": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp",
    "wordpress-language-dir": "web/app/languages",
    "wordpress-languages": ["es_ES"]
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest"
  }
}
